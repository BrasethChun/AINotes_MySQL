# GoDaddy Production Environment Configuration
NODE_ENV=production
PORT=3000

# Primary GoDaddy MySQL Database Connection
MYSQL_HOST=118.139.180.163
MYSQL_PORT=3306
MYSQL_USER=khema_dbuser
MYSQL_PASSWORD=your_godaddy_mysql_password
MYSQL_DATABASE=khema_ainotes
MYSQL_SSL=false
PRIMARY_DB=godaddy
PRIMARY_LOCKED=true

# Security & Authentication
JWT_SECRET=generate_a_secure_random_64_character_hex_string

# Gemini AI (Optional - for Mail Assistant Smart Replies & Summaries)
GEMINI_API_KEY=your_gemini_api_key

# Telegram Heartbeat & Database Drop Disconnection Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id